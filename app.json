{
  "expo": {
    "name": "Wonderport",
    "slug": "wonderport",
    "scheme": "wonderport",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chalynai.wonderport",
      "buildNumber": "4",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "Wonderport",
        "NSPhotoLibraryUsageDescription": "Wonderport uses your photo library so you can set a profile picture, share images in community chat, and upload EFT payment proof."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.chalynai.wonderport",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wonderport uses your photo library so you can set a profile picture, share images in community chat, and upload EFT payment proof."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0efaba92-5a74-430b-b99f-b139552c1003"
      }
    },
    "owner": "chalynai"
  }
}
